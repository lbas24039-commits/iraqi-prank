<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BLACK SITE // ACCESS</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap');

*{box-sizing:border-box}

body{
    margin:0;
    min-height:100vh;
    background:#020403;
    color:#00ff66;
    font-family:'Share Tech Mono',monospace;
    overflow:hidden;
}

body:before{
    content:"";
    position:fixed;
    inset:0;
    background:
      linear-gradient(rgba(0,255,100,.035) 1px,transparent 1px),
      linear-gradient(90deg,rgba(0,255,100,.025) 1px,transparent 1px);
    background-size:25px 25px;
    pointer-events:none;
}

.scanlines{
    position:fixed;
    inset:0;
    pointer-events:none;
    background:repeating-linear-gradient(
        0deg,
        transparent 0px,
        transparent 3px,
        rgba(0,255,100,.035) 4px
    );
    z-index:20;
}

.glitch{
    animation:glitch .15s infinite;
}

@keyframes glitch{
    0%{transform:translate(0)}
    25%{transform:translate(1px,-1px)}
    50%{transform:translate(-1px,1px)}
    75%{transform:translate(1px,1px)}
    100%{transform:translate(0)}
}

.container{
    width:min(950px,94%);
    margin:30px auto;
    border:1px solid #00ff66;
    box-shadow:
      0 0 20px rgba(0,255,100,.2),
      inset 0 0 25px rgba(0,255,100,.04);
    background:rgba(0,8,4,.94);
}

.header{
    padding:12px 18px;
    border-bottom:1px solid #00ff66;
    display:flex;
    justify-content:space-between;
    font-size:13px;
}

.red{
    color:#ff3030;
}

.terminal{
    padding:20px;
    height:75vh;
    overflow:hidden;
}

.line{
    margin:9px 0;
    white-space:pre-wrap;
    text-shadow:0 0 8px #00ff66;
}

.dim{
    color:#4d9b68;
}

.warning{
    color:#ff3333;
    text-shadow:0 0 10px red;
}

.cursor{
    display:inline-block;
    width:9px;
    height:18px;
    background:#00ff66;
    animation:blink .7s infinite;
    vertical-align:middle;
}

@keyframes blink{
    50%{opacity:0}
}

.progress{
    width:100%;
    height:14px;
    border:1px solid #00ff66;
    margin:18px 0;
}

.progress span{
    display:block;
    width:0%;
    height:100%;
    background:#00ff66;
    box-shadow:0 0 12px #00ff66;
}

.fake-data{
    display:none;
    border:1px dashed #00ff66;
    padding:18px;
    margin-top:18px;
}

.fake-data div{
    padding:7px;
    border-bottom:1px solid rgba(0,255,100,.15);
}

button{
    margin-top:20px;
    background:#001a09;
    color:#00ff66;
    border:1px solid #00ff66;
    padding:12px 20px;
    font-family:inherit;
    cursor:pointer;
}

button:hover{
    background:#00ff66;
    color:#000;
}

.prank{
    display:none;
    color:#ffd000;
    font-size:20px;
    text-align:center;
    margin-top:25px;
}
</style>
</head>

<body>

<div class="scanlines"></div>

<div class="container">

<div class="header">
    <span>BLACK SITE // TERMINAL 07</span>
    <span class="red">● SECURITY ALERT</span>
</div>

<div class="terminal" id="terminal">

<div class="line glitch">
> INITIALIZING SHADOW PROTOCOL...
</div>

<div class="line dim">
> encrypted channel: ACTIVE
</div>

<div class="line">
> الاتصال بالقاعدة السرية...
</div>

<div class="line" id="status">
> جاري التحقق...
</div>

<div class="progress">
    <span id="bar"></span>
</div>

<div id="logs"></div>

<div class="fake-data" id="data">

    <div>> CLASSIFICATION: <b>TOP SECRET</b></div>
    <div>> SUBJECT: الشخص اللي فتح الرابط 👀</div>
    <div>> THREAT LEVEL: <b class="warning">99%</b></div>
    <div>> IQ STATUS: جاري البحث... 😂</div>
    <div>> LOCATION: <b>بالقرب من الثلاجة غالباً</b></div>
    <div>> CURRENT MISSION: <b>يشوف شنو هذا الرابط</b></div>
    <div>> SECURITY STATUS: <b class="warning">انكشفنا 😂</b></div>

</div>

<div class="prank" id="prank">
    ⚠️ ولك اهدأ 😂<br><br>
    هذا مقلب يا وحش!
    <br>
    ما أخذنا موقعك ولا الكاميرا ولا أي بيانات حقيقية.
    <br><br>

    <button onclick="location.reload()">
        🔄 عيد المقلب
    </button>
</div>

</div>
</div>

<script>

const bar = document.getElementById("bar");
const status = document.getElementById("status");
const logs = document.getElementById("logs");
const data = document.getElementById("data");
const prank = document.getElementById("prank");

let progress = 0;

const messages = [
"> فتح قناة مشفرة...",
"> تحميل البروتوكول الأسود...",
"> تحليل مستوى الخطر...",
"> فحص السجل السري...",
"> البحث عن صاحب الجهاز...",
"> لحظة... هذا شكله جاي يشوف المقلب 😂",
"> تجاوز جدار الحماية...",
"> تقريباً خلصنا...",
"> النظام يقول: لا تخاف حبيبي 😂"
];

function beep(){

    const AudioContext =
        window.AudioContext || window.webkitAudioContext;

    if(!AudioContext) return;

    const ctx = new AudioContext();
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();

    osc.frequency.value =
        180 + Math.random()*300;

    gain.gain.setValueAtTime(
        .03,
        ctx.currentTime
    );

    gain.gain.exponentialRampToValueAtTime(
        .001,
        ctx.currentTime+.12
    );

    osc.connect(gain);
    gain.connect(ctx.destination);

    osc.start();
    osc.stop(ctx.currentTime+.12);
}

function addLog(text){

    const div = document.createElement("div");

    div.className = "line";

    div.textContent = text;

    logs.appendChild(div);

    beep();
}

const timer = setInterval(()=>{

    progress += Math.floor(Math.random()*9)+4;

    if(progress >= 100){

        progress = 100;

        clearInterval(timer);

        bar.style.width = "100%";

        status.textContent =
        "> ACCESS GRANTED // فتح الملف السري...";

        setTimeout(()=>{

            data.style.display = "block";

            setTimeout(()=>{

                prank.style.display = "block";

            },1800);

        },900);

    }else{

        bar.style.width =
        progress + "%";

        if(Math.random()>.35){

            const index =
            Math.min(
                Math.floor(progress/11),
                messages.length-1
            );

            addLog(messages[index]);

        }

    }

},700);

</script>

</body>
</html>
